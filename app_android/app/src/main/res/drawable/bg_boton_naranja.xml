<?xml version="1.0" encoding="utf-8"?>
<!-- botón principal: degradado violeta → cian con ripple; gris cuando está deshabilitado -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_claro">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/fondo_tarjeta_alta" />
                    <stroke android:width="1dp" android:color="@color/borde" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:centerColor="@color/acento_medio"
                        android:endColor="@color/acento_fin"
                        android:startColor="@color/acento_inicio"
                        android:type="linear" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
