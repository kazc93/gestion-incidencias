<?xml version="1.0" encoding="utf-8"?>
<!-- encabezado con "luces" difusas violeta y cian sobre el fondo oscuro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_principal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.1"
                android:endColor="#000A0E1A"
                android:gradientRadius="260dp"
                android:startColor="@color/acento_brillo"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.6"
                android:endColor="#000A0E1A"
                android:gradientRadius="220dp"
                android:startColor="@color/acento_brillo_cian"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
