<?xml version="1.0" encoding="utf-8"?>
<!-- campo de texto: el borde se ilumina en violeta al enfocarlo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="180"
    android:exitFadeDuration="180">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_campo" />
            <stroke android:width="1.5dp" android:color="@color/borde_foco" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_tarjeta_alta" />
            <stroke android:width="1dp" android:color="@color/borde_foco" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_campo" />
            <stroke android:width="1dp" android:color="@color/borde" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
