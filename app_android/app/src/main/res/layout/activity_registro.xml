<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:orientation="vertical">

    <!-- encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            android:stateListAnimator="@animator/presion_escala" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Etiqueta"
                android:text="Nuevo reporte"
                android:textColor="@color/acento_fin" />

            <TextView
                style="@style/Texto.TituloPantalla"
                android:text="Registrar incidencia" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/cascada_secciones"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- 1. información -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Título del problema" />

                <EditText
                    android:id="@+id/etTitulo"
                    style="@style/Campo"
                    android:layout_height="52dp"
                    android:hint="Ej. Lámpara quemada en pasillo"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Descripción detallada" />

                <EditText
                    android:id="@+id/etDescripcion"
                    style="@style/Campo"
                    android:layout_height="120dp"
                    android:layout_marginBottom="0dp"
                    android:gravity="top"
                    android:hint="Describe qué pasó y dónde"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- 2. clasificación -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Reportado por" />

                <Spinner
                    android:id="@+id/spReporta"
                    style="@style/CampoSpinner" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:text="Tipo" />

                        <Spinner
                            android:id="@+id/spTipo"
                            style="@style/CampoSpinner"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:text="Prioridad" />

                        <Spinner
                            android:id="@+id/spPrioridad"
                            style="@style/CampoSpinner"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. evidencia -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Evidencia fotográfica" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Obligatoria: toma una foto del problema."
                    android:textColor="@color/texto_tenue"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_foto"
                    android:clipToOutline="true"
                    android:contentDescription="Vista previa de la fotografía"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnTomarFoto"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_boton_secundario"
                    android:text="Tomar fotografía"
                    android:textAllCaps="false"
                    android:textColor="@color/titulo"
                    app:icon="@drawable/ic_camara"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/boton" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="GUARDAR INCIDENCIA"
        android:textSize="15sp" />

</LinearLayout>
