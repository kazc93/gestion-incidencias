<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:orientation="vertical">

    <!-- encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            android:stateListAnimator="@animator/presion_escala" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Etiqueta"
                android:text="Paso 2 de 4"
                android:textColor="@color/texto_asignada" />

            <TextView
                style="@style/Texto.TituloPantalla"
                android:text="Asignar responsable" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/cascada_secciones"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- incidencia -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    android:id="@+id/tvFolio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/acento_fin"
                    android:textSize="13sp"
                    tools:text="INC-2026-00001" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/titulo"
                    android:textSize="18sp"
                    tools:text="Lámpara quemada" />
            </LinearLayout>

            <!-- formulario -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Responsable" />

                <Spinner
                    android:id="@+id/spResponsable"
                    style="@style/CampoSpinner" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Asignado por" />

                <Spinner
                    android:id="@+id/spAsigna"
                    style="@style/CampoSpinner" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Comentario (opcional)" />

                <EditText
                    android:id="@+id/etComentario"
                    style="@style/Campo"
                    android:layout_height="100dp"
                    android:layout_marginBottom="0dp"
                    android:gravity="top"
                    android:hint="Agrega una nota para el responsable"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="16dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmarAsignacion"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="CONFIRMAR ASIGNACIÓN"
        android:textSize="15sp" />

</LinearLayout>
