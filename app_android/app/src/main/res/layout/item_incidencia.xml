<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    android:background="@drawable/bg_tarjeta_item"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:stateListAnimator="@animator/presion_escala">

    <!-- barra de color según el estado -->
    <View
        android:id="@+id/vBarraEstado"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="18dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_barra_estado"
        android:backgroundTint="@color/texto_pendiente" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvListado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                tools:text="INC-2026-00001" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_estado_pendiente"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/texto_pendiente"
                android:textSize="11sp"
                tools:text="REGISTRADA" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/titulo"
            android:textSize="17sp"
            tools:text="Lámpara quemada en pasillo" />

        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Eléctrica • Prioridad Alta" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_calendario"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/texto_tenue"
            android:textSize="12sp"
            tools:text="Reportado el: 20/10/2026" />
    </LinearLayout>
</LinearLayout>
