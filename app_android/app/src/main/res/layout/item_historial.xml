<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- línea de tiempo -->
    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="match_parent">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_linea_tiempo" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_punto" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:textColor="@color/titulo"
            android:textSize="14sp"
            tools:text="ASIGNACION" />

        <TextView
            android:id="@+id/tvCambioEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/acento_fin"
            android:textSize="13sp"
            tools:text="REGISTRADA → ASIGNADA" />

        <TextView
            android:id="@+id/tvResponsableAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Por: Ana López" />

        <TextView
            android:id="@+id/tvFechaAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_tenue"
            android:textSize="12sp"
            tools:text="20/10/2026 10:30" />
    </LinearLayout>
</LinearLayout>
