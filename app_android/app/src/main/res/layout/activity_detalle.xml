<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:orientation="vertical">

    <!-- encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            android:stateListAnimator="@animator/presion_escala" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Etiqueta"
                android:text="Seguimiento"
                android:textColor="@color/acento_fin" />

            <TextView
                style="@style/Texto.TituloPantalla"
                android:text="Detalle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_estado_pendiente"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/texto_pendiente"
            android:textSize="11sp"
            tools:text="REGISTRADA" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/cascada_secciones"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- datos generales -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    android:id="@+id/tvFolio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textColor="@color/acento_fin"
                    android:textSize="13sp"
                    tools:text="INC-2026-00001" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/titulo"
                    android:textSize="22sp"
                    tools:text="Lámpara quemada" />

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp"
                    tools:text="No enciende la lámpara del pasillo principal" />

                <TextView
                    android:id="@+id/tvDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_chip_contador"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/titulo"
                    android:textSize="13sp"
                    tools:text="Eléctrica • Prioridad Media" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/borde" />

                <TextView
                    android:id="@+id/tvReporta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_persona"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text="Reportado por: Carlos Morales" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_calendario"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text="Reportado el: 20/10/2026" />
            </LinearLayout>

            <!-- responsable -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Responsable" />

                <TextView
                    android:id="@+id/tvResponsable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_persona"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/titulo"
                    android:textSize="16sp"
                    tools:text="Sin responsable asignado" />
            </LinearLayout>

            <!-- evidencias -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Fotografía inicial" />

                <ImageView
                    android:id="@+id/ivFotoInicial"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_foto"
                    android:clipToOutline="true"
                    android:contentDescription="Fotografía inicial de la incidencia"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/llFotoFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:text="Fotografía final"
                        android:textColor="@color/texto_resuelta" />

                    <ImageView
                        android:id="@+id/ivFotoFinal"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_foto"
                        android:clipToOutline="true"
                        android:contentDescription="Fotografía final de la incidencia"
                        android:scaleType="centerCrop" />
                </LinearLayout>
            </LinearLayout>

            <!-- solución -->
            <LinearLayout
                android:id="@+id/llSolucion"
                style="@style/Tarjeta"
                android:visibility="gone">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Solución"
                    android:textColor="@color/texto_resuelta" />

                <TextView
                    android:id="@+id/tvSolucion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/titulo"
                    android:textSize="15sp"
                    tools:text="Se cambió la lámpara por una nueva" />
            </LinearLayout>

            <!-- historial -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Historial" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layoutAnimation="@anim/cascada_items"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_historial" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnAccion"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="ASIGNAR RESPONSABLE"
        android:textSize="15sp" />

</LinearLayout>
