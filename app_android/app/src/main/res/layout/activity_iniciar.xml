<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:orientation="vertical">

    <!-- encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            android:stateListAnimator="@animator/presion_escala" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Etiqueta"
                android:text="Paso 3 de 4"
                android:textColor="@color/texto_en_atencion" />

            <TextView
                style="@style/Texto.TituloPantalla"
                android:text="Iniciar atención" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/cascada_secciones"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- incidencia -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    android:id="@+id/tvFolio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/acento_fin"
                    android:textSize="13sp"
                    tools:text="INC-2026-00001" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/titulo"
                    android:textSize="18sp"
                    tools:text="Lámpara quemada" />

                <TextView
                    android:id="@+id/tvResponsable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_persona"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    tools:text="Responsable: Luis Hernández" />
            </LinearLayout>

            <!-- formulario -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:text="Quién inicia la atención" />

                <Spinner
                    android:id="@+id/spEmpleado"
                    style="@style/CampoSpinner" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_estado_atencion"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Al confirmar, la incidencia pasará al estado EN ATENCIÓN."
                    android:textColor="@color/texto_en_atencion"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmarInicio"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="INICIAR ATENCIÓN"
        android:textSize="15sp" />

</LinearLayout>
